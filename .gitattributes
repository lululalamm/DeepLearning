# Normalize line endings across platforms
* text=auto

# Explicitly treat these as text with LF
*.py    text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ipynb text eol=lf

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.onnx  binary
*.pkl   binary
*.caffemodel binary
